# Public URLs of the Tei Technologies products (TeiCraft, TeiWill).
# This site never imports code from them- only links out.
# Leave empty to use the in-site detail pages (/products/teicraft, /products/teiwill).
NEXT_PUBLIC_TEICRAFT_URL=
NEXT_PUBLIC_TEIWILL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=info@teitechnologies.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Inbox for "Start a project" enquiries (shown on the contact page).
NEXT_PUBLIC_ADMIN_EMAIL=info@teitechnologies.com

# --- Server-only: project enquiry delivery (never expose with NEXT_PUBLIC_) ---
# The "Start a project" form POSTs to /api/project-enquiry, which emails the
# brief to ADMIN_EMAIL via SMTP. Works with Gmail, Zoho, cPanel, etc.
# For Gmail use an App Password (not your login password).
ADMIN_EMAIL=info@teitechnologies.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: the From address (defaults to SMTP_USER).
SMTP_FROM=

# Social profiles shown on /contact (leave empty to hide that network).
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/teitechnologies
NEXT_PUBLIC_X_URL=https://x.com/teitechnologies
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/teitechnologies
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/teitechnologies
